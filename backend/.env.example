# =============================================================
# FreightFlow - Environment Configuration Template
# Copy this file to ".env" on the server, then fill in values.
# NEVER commit the real .env. Never include it in public_html.
# ALL config values come ONLY from this file - no code defaults.
# =============================================================

APP_NAME=FreightFlow
APP_ENV=production
APP_KEY=                                   # RUN: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com             # No trailing slash
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ---- Database (cPanel "MySQL Databases") ----
DB_CONNECTION=mysql
DB_HOST=localhost                          # cPanel databases use "localhost"
DB_PORT=3306
DB_DATABASE=cpaneluser_fedexus             # e.g. cpaneluser_mydb
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=                               # The password you set in cPanel

# ---- Cache / Session / Queue / Broadcast (shared hosting: NO Redis) ----
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_CONNECTION=
SESSION_TABLE=sessions
SESSION_STORE=
SESSION_COOKIE=freightflow_session
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=
QUEUE_CONNECTION=sync                      # App has no queue jobs; sync is fine
REDIS_QUEUE=default
BROADCAST_CONNECTION=log                   # Reverb optional; app works without it

# ---- Redis (ONLY if you use Redis cache/session/queue) ----
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Reverb (OPTIONAL websockets. Leave blank on shared hosting) ----
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=8080
REVERB_SCHEME=http

# ---- Sanctum ----
SANCTUM_STATEFUL_DOMAINS=yourdomain.com
SANCTUM_TOKEN_EXPIRATION=720

# ---- Mail (can also be configured later in Admin -> Settings -> Email) ----
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=                             # SMTP / cPanel email password
MAIL_ENCRYPTION=tls
MAIL_EHLO_DOMAIN=
MAIL_LOG_CHANNEL=
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="FreightFlow"
MAIL_REPLY_TO_ADDRESS=noreply@yourdomain.com
MAIL_REPLY_TO_NAME="FreightFlow"

# ---- Payment Gateway API Endpoints ----
FLUTTERWAVE_API_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_GUEST_EMAIL=guest@yourdomain.com
STRIPE_API_URL=https://api.stripe.com/v1
PAYPAL_SANDBOX_URL=https://api-m.sandbox.paypal.com
PAYPAL_LIVE_URL=https://api-m.paypal.com
NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1

# ---- Payment Gateway Keys ----
# Flutterwave (configure public + secret in Admin Panel too)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# NOWPayments (Crypto)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Optional Third-Party Integrations ----
POSTMARK_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

# ---- Geocoding / Map ----
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT="FreightFlow/1.0"

# ---- Admin Security ----
ADMIN_SESSION_TIMEOUT_MINUTES=30
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_DECAY_SECONDS=900
ADMIN_CAPTCHA_TTL_SECONDS=300
ADMIN_IP_ALLOWLIST=                     # comma-separated. Empty = allow all
ADMIN_IP_BLOCKLIST=                     # comma-separated. Empty = block none
ADMIN_TRUSTED_DEVICE_WINDOW_DAYS=30

# ---- Seed (non-production only) ----
SEED_ADMIN_PASSWORD=                    # used ONLY when running php artisan db:seed locally